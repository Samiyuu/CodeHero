<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2A0A3F" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#D58BFF" android:endColor="#7A1FD6" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
