<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:padding="12dp">

    <TextView style="@style/PixelButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/panel_green" android:minWidth="0dp"
        android:paddingBottom="12dp" android:text="PAUSED" />

    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/wood_sign"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
        <TextView android:id="@+id/btnResume" style="@style/PixelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_yellow" android:text="RESUME" />
        <TextView android:id="@+id/btnQuitGame" style="@style/PixelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/btn_brown" android:text="QUIT" />
    </LinearLayout>
</LinearLayout>
