<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sceneRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_glitch">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">

        <com.ccat.coderhero.BevelTextView android:id="@+id/panelTop" style="@style/Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="20dp"
            android:fontFamily="@font/orbitron_font"
            android:textSize="22sp" android:textStyle="bold" />
        <com.ccat.coderhero.BevelTextView android:id="@+id/panelBottom" style="@style/Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="20dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/orbitron_font"
            app:bvFill="#A8003A" app:bvOuter="#4A0018" app:bvLine="#E56A8E" app:bvStripes="true" />

        <com.ccat.coderhero.HeroView android:id="@+id/hero"
            android:layout_width="200dp" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="12dp" />

        <TextView android:id="@+id/btnNext" style="@style/PixelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
            android:background="@drawable/btn_yellow" android:text="CONTINUE" />
    </LinearLayout>
</FrameLayout>
