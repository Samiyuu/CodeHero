<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_main_coderhero">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">

        <TextView style="@style/PixelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/panel_green" android:minWidth="0dp"
            android:paddingBottom="12dp" android:text="SELECT MODE" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="14dp" android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/wood_sign" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="24dp">

                <TextView
                    android:id="@+id/btnStory"
                    style="@style/PixelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_yellow"
                    android:minWidth="0dp"
                    android:text="@string/mode_story"
                    android:textSize="18sp" />
                <TextView android:id="@+id/storyInfo" style="@style/Panel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/wood_text" android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnEndless"
                    style="@style/PixelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_yellow"
                    android:minWidth="0dp"
                    android:text="@string/mode_endless"
                    android:textSize="18sp" />
                <TextView android:id="@+id/endlessInfo" style="@style/Panel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/wood_text" android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnDaily"
                    style="@style/PixelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_yellow"
                    android:minWidth="0dp"
                    android:text="@string/mode_daily"
                    android:textSize="18sp" />
                <TextView android:id="@+id/dailyInfo" style="@style/Panel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/wood_text" android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPractice"
                    style="@style/PixelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_blue"
                    android:minWidth="0dp"
                    android:text="@string/mode_practice"
                    android:textSize="18sp" />
                <TextView android:id="@+id/practiceInfo" style="@style/Panel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/info_practice"
                    android:textColor="@color/wood_text" android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnLearn"
                    style="@style/PixelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_blue"
                    android:minWidth="0dp"
                    android:text="@string/mode_learn"
                    android:textSize="18sp" />
                <TextView android:id="@+id/learnInfo" style="@style/Panel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/info_learn"
                    android:textColor="@color/wood_text" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <TextView android:id="@+id/btnBack" style="@style/PixelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
            android:background="@drawable/btn_brown" android:text="@string/back" />
    </LinearLayout>
</FrameLayout>
